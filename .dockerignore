# Keep the build context small and reproducible.
# NOTE: backend/app/icons/svg is intentionally NOT ignored — the SVGs are baked
# into the image (and fetch_icons.py tops up any that are missing).

.git
.gitignore
**/__pycache__/
**/*.py[cod]
**/.mypy_cache/
**/.pytest_cache/
**/*.egg-info/

# Python virtualenvs
backend/.venv/
**/venv/

# Local data (DB, avatars, uploads) — provided at runtime via the bind mount
data/
backend/data/

# Frontend — node_modules and dist are rebuilt inside the image
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/.playwright-mcp/
.playwright-mcp/

# Docs / scratch not needed in the image
*.md
docs/
