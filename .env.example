# Copy to .env and adjust before running `docker compose up -d`.

# Secret used to sign the session cookie. REQUIRED — generate a random value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# With APP_ENV=production an unset/weak value fails startup (no silent fallback).
SESSION_SECRET=change-me-to-a-long-random-string

# Host directory bind-mounted to /app/data (SQLite DB + uploaded files).
DATA_DIR=/mnt/raid/padelerodouleies/data

# --- Internet-exposure hardening (see README "Exposing to the internet") ------
# docker-compose.prod.yml already sets APP_ENV=production, which turns on the
# Secure cookie, HSTS, hidden OpenAPI and the fail-explicit secret. The two below
# are the only knobs you normally touch:
#
# Trust X-Forwarded-For for the client IP (per-IP rate limiting). Set to 1 ONLY
# behind a TLS reverse proxy / tunnel that overwrites the header; otherwise
# clients can spoof it. Leave 0 until the proxy is in place.
TRUST_PROXY=0
#
# Emit HSTS (defaults on in production). Set 0 while first validating TLS so a
# misconfig doesn't pin browsers to HTTPS for a year; remove once stable.
# ENABLE_HSTS=0

# GHCR image tag to deploy with docker-compose.prod.yml. Use `latest` to track
# main, or pin a `sha-<short>` / semver tag for reproducible deploys & rollback.
IMAGE_TAG=latest
